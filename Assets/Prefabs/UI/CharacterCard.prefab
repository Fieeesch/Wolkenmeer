  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Gisberta ist die gerechte K\xF6nigin des Wolkenmeers, bekannt f\xFCr ihre
    G\xFCte und unersch\xFCtterliche Entschlossenheit. Seit der finstere Wudus ihre
    Schleimis verhext hat, k\xE4mpft sie mit aller Kraft, ihr Volk zu retten. Trotz
    ihrer k\xF6niglichen W\xFCrde scheut sie sich nicht, selbst in die Schlacht zu
    ziehen, denn f\xFCr Gisberta z\xE4hlt nicht der Titel, sondern das Herz. Mit
    klarem Verstand und unersch\xFCtterlicher Hoffnung f\xFChrt sie die Heldengruppe
    an, um das Wolkenmeer wieder in Frieden zu vereinen."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 82994e12b6422d143ba7503abe8c331c, type: 2}
  m_sharedMaterial: {fileID: -2206109567050784678, guid: 82994e12b6422d143ba7503abe8c331c, type: 2}
